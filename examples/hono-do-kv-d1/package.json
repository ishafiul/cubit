{
  "name": "hono-do-kv-d1",
  "version": "1.0.0",
  "private": true,
  "description": "Hono Cloudflare Worker with Durable Objects, KV, and D1",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "esbuild src/index.ts --bundle --format=esm --target=es2022 --outfile=dist-worker.js",
    "d1:init": "wrangler d1 execute app_db --local --file=./schema.sql"
  },
  "dependencies": {
    "hono": "^4.6.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.5.4",
    "wrangler": "^3.78.10"
  }
}
