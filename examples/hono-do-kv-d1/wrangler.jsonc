{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hono-do-kv-d1",
  "main": "src/index.ts",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "kv_namespaces": [
    {
      "binding": "KV_CACHE",
      "id": "app_kv_cache"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "app_db",
      "database_id": "app_db_id"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COUNTER_DO",
        "class_name": "CounterDO"
      }
    ]
  },
  "vars": {
    "APP_NAME": "Hono State Suite (DO + KV + D1)"
  }
}
