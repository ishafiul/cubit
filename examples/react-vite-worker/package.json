{
  "name": "react-vite-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Simple React with Vite and Cloudflare Wrangler setup",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild worker/index.ts --bundle --format=esm --target=es2022 --outfile=dist-worker.js",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.5.4",
    "vite": "^5.4.8",
    "wrangler": "^3.78.10"
  }
}
